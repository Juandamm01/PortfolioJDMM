---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Certifications from '../components/Certifications.astro';
import Badges from '../components/Badges.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script is:inline>
        document.addEventListener('astro:page-load', () => {
            if (window.location.pathname.includes('/certificaciones')) {
                window.scrollTo({ top: 0, behavior: 'instant' });
            }
        });
    </script>

    <div style="display: flex; flex-direction: column; min-height: 100vh; width: 100%;">
        <div class="portfolio-container" style="min-height: auto; position: relative; z-index: 50;">
            <Navbar />
        </div>

        <div style="padding-top: 120px; padding-bottom: 60px; flex: 1;">
            <Certifications />
            <Badges />
        </div>

        <Footer />
    </div>
</Layout>
