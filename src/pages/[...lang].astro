---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Process from '../components/sections/Process.astro';
import Experience from '../components/sections/Experience.astro';
import Projects from '../components/sections/Projects.astro';
import Contact from '../components/sections/Contact.astro';
import { getLang } from '../i18n/ui';

// One template, two static pages: `/` (Spanish) and `/en/` (English).
export const getStaticPaths = (() => [{ params: { lang: undefined } }, { params: { lang: 'en' } }]) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
---

<BaseLayout lang={lang}>
  <Hero lang={lang} />
  <About lang={lang} />
  <Process lang={lang} />
  <Experience lang={lang} />
  <Projects lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
