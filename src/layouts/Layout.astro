---
 import '../styles/global.css';
import dartVaderIcon from '../assets/DartVader.png';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<!-- Modified the title and favicon as requested -->
		<link rel="icon" type="image/png" href={dartVaderIcon.src} />
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio Juan David Martinez</title>
	</head>
	<body>
		<slot />

		<!-- Lenis Smooth Scroll -->
		<script is:inline src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
		<script is:inline>
			document.addEventListener("DOMContentLoaded", () => {
				if (typeof Lenis !== 'undefined') {
					const lenis = new Lenis({
						duration: 1.4,
						easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
						smooth: true,
						smoothTouch: false,
					});

					function raf(time) {
						lenis.raf(time);
						requestAnimationFrame(raf);
					}
					requestAnimationFrame(raf);

					document.querySelectorAll('a[href^="#"]').forEach(anchor => {
						anchor.addEventListener('click', function (e) {
							e.preventDefault();
							const targetId = this.getAttribute('href');
							if (targetId === '#') return;
							const targetElement = document.querySelector(targetId);
							if (targetElement) {
								lenis.scrollTo(targetElement, {
									duration: 1.5,
									easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
									offset: -80
								});
							}
						});
					});
				}
			});
		</script>
	</body>
</html>
