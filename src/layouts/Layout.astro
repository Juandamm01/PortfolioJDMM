---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import dartVaderIcon from '../assets/DartVader.png';
import PixelSnow from '../animations/PixelSnow.jsx';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<!-- Modified the title and favicon as requested -->
		<link rel="icon" type="image/png" href={dartVaderIcon.src} />
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio Juan David Martinez</title>
		<ClientRouter />
	</head>
	<body>
		<div class="pixel-snow-global-wrapper">
			<PixelSnow 
				client:load
				color="#87b5ff"
				flakeSize={0.01}
				minFlakeSize={1.25}
				pixelResolution={200}
				speed={1.25}
				density={0.3}
				direction={125}
				brightness={1}
			/>
		</div>
		<slot />

		<!-- Lenis Smooth Scroll -->
		<script is:inline src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
		<script is:inline>
			// Evitar flash del home al navegar a hashes con View Transitions
			document.addEventListener('astro:after-swap', () => {
				const hash = window.location.hash;
				if (hash) {
					const target = document.querySelector(hash);
					if (target) {
						window.scrollTo({ top: target.offsetTop - 80, behavior: 'instant' });
					}
				}
			});

			document.addEventListener("astro:page-load", () => {
				if (typeof Lenis !== 'undefined') {
					const lenis = new Lenis({
						duration: 1.4,
						easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
						smooth: true,
						smoothTouch: false,
					});

					window.__portfolioLenis = lenis;

					function raf(time) {
						lenis.raf(time);
						requestAnimationFrame(raf);
					}
					requestAnimationFrame(raf);

					document.querySelectorAll('a[href^="#"], a[href^="/#"]').forEach(anchor => {
						anchor.addEventListener('click', function (e) {
							const href = this.getAttribute('href');
							if (href === '#') return;
							
							const hash = href.includes('#') ? '#' + href.split('#')[1] : href;
							const targetElement = document.querySelector(hash);
							
							if (targetElement) {
								e.preventDefault();
								lenis.scrollTo(targetElement, {
									duration: 0.8,
									easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
									offset: -80
								});
							}
						});
					});
				}
			});
		</script>
	</body>
</html>
