---
import { Image } from 'astro:assets';
import dentalImg from '../assets/Dra-Camila.png';
import constructionImg from '../assets/BCAS.png';
---

<section id="project" class="projects-section">
    <div class="projects-container">
        <div class="projects-header project-anim">
            <div class="badge" data-i18n="projects_badge">Mi Trabajo</div>
            <h2 class="glitch-text" data-i18n="projects_title">Proyectos <br/> <span class="text-cyan">Destacados</span></h2>
        </div>

        <!-- Jedi Lightsaber Background -->
        <div class="lightsaber-bg">
            <div class="saber-hilt">
                <div class="hilt-detail"></div>
            </div>
            <div class="saber-blade blade-anim"></div>
        </div>

        <div class="projects-grid">
            <!-- Project 1 -->
            <article class="project-card project-anim">
                <div class="project-image-wrapper">
                    <Image src={dentalImg} alt="Dra Camila Henao Web" class="project-image" />
                    <div class="project-overlay">
                        <a href="https://github.com/Juandamm01/DraCamilaHenaoWeb" target="_blank" class="project-link" aria-label="Github Repo">
                            <svg viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg> 
                            <span data-i18n="btn_code">Ver Código</span>
                        </a>
                    </div>
                </div>
                <div class="project-content">
                    <h3 data-i18n="project1_title">Dra. Camila Henao Odontología</h3>
                    <p class="description" data-i18n="project1_desc">Página web de odontología moderna. <span class="text-cyan">(En Desarrollo)</span></p>
                    <div class="tech-stack small-stack">
                        <span class="tech-pill">Next.js</span>
                        <span class="tech-pill">Framer Motion</span>
                        <span class="tech-pill">GSAP</span>
                    </div>
                </div>
            </article>

            <!-- Project 2 -->
            <article class="project-card project-anim" style="animation-delay: 200ms;">
                <div class="project-image-wrapper">
                    <Image src={constructionImg} alt="Bioconstructores Asociados Web" class="project-image" />
                    <div class="project-overlay">
                        <a href="https://github.com/Juandamm01/BioconstructoresAsociadosSas" target="_blank" class="project-link" aria-label="Github Repo">
                            <svg viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg> 
                            <span data-i18n="btn_code">Ver Código</span>
                        </a>
                    </div>
                </div>
                <div class="project-content">
                    <h3 data-i18n="project2_title">Bioconstructores Asociados SAS</h3>
                    <p class="description" data-i18n="project2_desc">Panel de administración y landing corporativa Fullstack bajo arquitectura moderna.</p>
                    <div class="tech-stack small-stack">
                        <span class="tech-pill">Next.js</span>
                        <span class="tech-pill">React</span>
                        <span class="tech-pill">TypeScript</span>
                        <span class="tech-pill">Prisma</span>
                        <span class="tech-pill">Neon</span>
                        <span class="tech-pill">AWS S3</span>
                        <span class="tech-pill">GSAP</span>
                        <span class="tech-pill">Framer Motion</span>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>


<script>
    import { initProjectsInteractive } from '../logic/projects.js';
    
    document.addEventListener("DOMContentLoaded", () => {
        initProjectsInteractive();
    });
</script>
