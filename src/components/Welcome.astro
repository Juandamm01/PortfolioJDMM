---
import { Image } from 'astro:assets';
import portfolioImg from '../assets/portfolio.jpg';
import Navbar from './Navbar.astro';
---

<div class="portfolio-container" id="home">
    <!-- Componente Navbar extraído para mayor limpieza -->
    <Navbar />

    <!-- Lottie Player & Anime.js Scripts (Loaded early for the background) -->
    <script is:inline src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"></script>

    <!-- Background Lightning & Lottie Container -->
    <div class="lightning-container" id="lightning-container">
        <!-- SVG Lightning Path animado con AnimeJS -->
        <svg viewBox="0 0 200 1000" preserveAspectRatio="none" id="lightning" class="lightning-svg">
            <path d="M 100 0 L 80 150 L 130 220 L 70 380 L 150 500 L 40 680 L 110 820 L 80 1000" stroke="#00f3ff" stroke-width="4" fill="none" class="lightning-path" style="filter: drop-shadow(0 0 20px #00f3ff) drop-shadow(0 0 10px #00f3ff);"/>
            <path d="M 100 0 L 80 150 L 130 220 L 70 380 L 150 500 L 40 680 L 110 820 L 80 1000" stroke="#ffffff" stroke-width="2" fill="none" class="lightning-core" style="filter: drop-shadow(0 0 8px #fff);"/>
            <!-- Branches for a more realistic lightning effect -->
            <path d="M 80 150 L 40 220 L 30 300" stroke="#00f3ff" stroke-width="2" fill="none" class="lightning-path" style="filter: drop-shadow(0 0 12px #00f3ff);"/>
            <path d="M 130 220 L 170 300 L 190 350" stroke="#00f3ff" stroke-width="2" fill="none" class="lightning-path" style="filter: drop-shadow(0 0 12px #00f3ff);"/>
            <path d="M 150 500 L 180 580" stroke="#00f3ff" stroke-width="2" fill="none" class="lightning-path" style="filter: drop-shadow(0 0 12px #00f3ff);"/>
            <path d="M 40 680 L 10 750" stroke="#00f3ff" stroke-width="2" fill="none" class="lightning-path" style="filter: drop-shadow(0 0 12px #00f3ff);"/>
        </svg>

        <!-- Lottie Player de partículas -->
        <lottie-player 
            src="https://lottie.host/8c1592dc-e3a5-4f40-b69d-7db135ae8789/a3C2z2c10b.json" 
            background="transparent" 
            speed="1" 
            style="width: 100%; height: 100%; position: absolute; top:0; left:0; z-index: -1; opacity: 0.3" 
            loop 
            autoplay>
        </lottie-player>
    </div>

    <!-- Main Hero Section -->
    <main class="hero-section">
        <!-- Left Side: Content -->
        <div class="hero-content">
            <div class="badge entrance-anim" data-i18n="badge">Un desarrollador, guiado por la Fuerza.</div>
            
            <h1 class="glitch-text entrance-anim" data-i18n="title">BIENVENIDO A MI <span class="text-cyan">PORTAFOLIO</span></h1>
            
            <h2 class="entrance-anim"><span id="typed-text"></span><span class="blinking-cursor">|</span></h2>
            
            <p class="description entrance-anim" data-i18n="description">
                Soy un estudiante de 5º semestre de Desarrollo de Software con experiencia en proyectos Fullstack usando Next.js, React.js, Javascript, Kotlin y Flutter. Me apasiona construir aplicaciones web y móviles funcionales con buena experiencia de usuario. Busco una oportunidad para crecer como desarrollador Front-End y aportar mis habilidades en proyectos reales.
            </p>
            
            <div class="social-links entrance-anim">
                <a class="social-icon" href="https://github.com/Juandamm01" target="_blank" aria-label="GitHub">
                    <svg viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
                <a class="social-icon" href="https://www.linkedin.com/in/juan-david19/" target="_blank" aria-label="LinkedIn">
                    <svg viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                </a>
                <a class="social-icon" href="mailto:juandamm099@gmail.com" target="_blank" aria-label="Email">
                    <svg viewBox="0 0 24 24"><path d="M0 3v18h24v-18h-24zm6.623 7.929l-4.623 5.712v-9.458l4.623 3.746zm-4.141-5.929h19.035l-9.517 7.713-9.518-7.713zm5.694 7.188l3.824 3.099 3.83-3.104 5.612 6.817h-18.89l5.624-6.812zm9.208-1.264l4.616-3.741v9.348l-4.616-5.607z"/></svg>
                </a>
            </div>
        </div>

        <!-- Right Side: Developer ID Badge -->
        <div class="hero-visuals">
            <div class="id-card-wrapper entrance-anim">
                <div class="lanyard-string"></div>
                <!-- Interactive 3D Card -->
                <div class="id-card" id="developer-card">
                    <div class="card-header">
                        <span class="logo-icon small">JD</span> 
                        <span class="header-title" data-i18n="id_header">DESARROLLO DE SOFTWARE</span>
                    </div>
                    <div class="card-body">
                        <!-- Eliminado el texto vertical JUAN. El wrapper ahora ocupa todo el tamaño -->
                        <div class="photo-wrapper">
                            <Image src={portfolioImg} alt="Juan David Profile" class="profile-photo" />
                        </div>
                    </div>
                    <div class="card-footer">
                        <div class="footer-name">JUAN DAVID M.</div>
                        <div class="footer-role" data-i18n="id_role">DESARROLLADOR FRONT END</div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>


<script>
    import { initWelcomeInteractive } from '../logic/welcome.js';
    
    document.addEventListener("DOMContentLoaded", () => {
        initWelcomeInteractive();
    });
</script>
