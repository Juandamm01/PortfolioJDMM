---
import { Image } from "astro:assets";
import portfolioImg from "../assets/photos/JuanDa.jpg";
import DesarrolladorImg from "../assets/photos/Desarrollador.jpg";
import Navbar from "./Navbar.astro";
import StarBorder from "../animations/StarBorder.jsx";
import ImageDisplacement from "../animations/ImageDisplacement.jsx";
---

<div class="portfolio-container" id="home">
    <!-- Componente Navbar extraído para mayor limpieza -->
    <Navbar />

    <!-- Anime.js Scripts (Loaded early for the background) -->
    <script
        is:inline
        src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.2/anime.min.js"
    ></script>

    <!-- Main Hero Section -->
    <main class="hero-section">
        <!-- Left Side: Content -->
        <div class="hero-content">
            <div class="badge entrance-anim" data-i18n="badge">
                "Antes de la creación, viene la destrucción." — Bills
            </div>

            <h1 class="glitch-text entrance-anim" data-i18n="title">
                BIENVENIDO A MI <span class="text-cyan">PORTAFOLIO</span>
            </h1>

            <h2 class="entrance-anim">
                <span id="typed-text"></span><span class="blinking-cursor"
                    >|</span
                >
            </h2>

            <p class="description entrance-anim" data-i18n="description">
                Soy estudiante de <strong>6º semestre</strong> de Desarrollo de
                Software, con experiencia como desarrollador <strong
                    ><span class="text-cyan">Full Stack</span></strong
                > en proyectos reales usando <strong
                    ><span class="text-cyan">Next.js</span></strong
                >, <strong><span class="text-cyan">React.js</span></strong>, <strong
                    ><span class="text-cyan">JavaScript</span></strong
                > y <strong><span class="text-cyan">TypeScript</span></strong>.
                Me apasiona construir aplicaciones web y móviles funcionales,
                escalables y con una experiencia de usuario cuidada, trabajando
                tanto en el frontend como en el backend: desde la interfaz y la
                lógica de negocio, hasta la integración con bases de datos y
                APIs. Tengo experiencia manejando <strong>Docker</strong> para
                levantar entornos de desarrollo y facilitar el despliegue de mis
                proyectos, y también desarrollo aplicaciones móviles con <strong
                    ><span class="text-cyan">React Native</span></strong
                >, llevando ideas desde el diseño hasta un producto funcional.
                Me destaco por mi capacidad de aprendizaje continuo, mi buena
                comunicación y mi facilidad para trabajar en equipo, siempre
                buscando aportar soluciones técnicas sólidas y bien pensadas.
            </p>

            <div class="social-links entrance-anim">
                <a
                    class="social-icon"
                    href="https://github.com/Juandamm01"
                    target="_blank"
                    aria-label="GitHub"
                >
                    <svg viewBox="0 0 24 24"
                        ><path
                            d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                        ></path></svg
                    >
                </a>
                <a
                    class="social-icon"
                    href="https://www.linkedin.com/in/juan-david19/"
                    target="_blank"
                    aria-label="LinkedIn"
                >
                    <svg viewBox="0 0 24 24"
                        ><path
                            d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                        ></path></svg
                    >
                </a>
                <a
                    class="social-icon"
                    href="mailto:juandamm099@gmail.com"
                    target="_blank"
                    aria-label="Email"
                >
                    <svg viewBox="0 0 24 24"
                        ><path
                            d="M0 3v18h24v-18h-24zm6.623 7.929l-4.623 5.712v-9.458l4.623 3.746zm-4.141-5.929h19.035l-9.517 7.713-9.518-7.713zm5.694 7.188l3.824 3.099 3.83-3.104 5.612 6.817h-18.89l5.624-6.812zm9.208-1.264l4.616-3.741v9.348l-4.616-5.607z"
                        ></path></svg
                    >
                </a>
                <a
                    class="cv-btn entrance-anim"
                    id="download-cv-btn"
                    href="/pdf/Juan_David_Martinez_CV_ES.pdf"
                    target="_blank"
                    download="Juan_David_Martinez_CV_ES.pdf"
                >
                    <svg viewBox="0 0 24 24"
                        ><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                        ></path></svg
                    >
                    <span data-i18n="download_cv">Descargar CV</span>
                </a>
            </div>
        </div>

        <!-- Right Side: Developer ID Badge -->
        <div class="hero-visuals entrance-anim">
            <div class="id-card-wrapper">
                <!-- Interactive 3D Card -->
                <StarBorder client:load id="developer-card" color="cyan" speed="6s" borderRadius="12px" className="id-card-star">
                    <div class="id-card">
                        <div class="card-header">
                            <span class="logo-icon small">JD</span>
                            <span class="header-title" data-i18n="id_header"
                                >DESARROLLO DE SOFTWARE</span
                            >
                        </div>
                        <div class="card-body">
                            <!-- Eliminado el texto vertical JUAN. El wrapper ahora ocupa todo el tamaño -->
                            <div class="photo-wrapper" style="position: relative;">
                                <Image
                                    src={portfolioImg}
                                    alt="Juan David Profile"
                                    class="profile-photo"
                                />
                                <ImageDisplacement 
                                    client:only="react"
                                    imageSrc={portfolioImg.src} 
                                    hoverImageSrc={DesarrolladorImg.src} 
                                />
                            </div>
                        </div>
                        <div class="card-footer">
                            <div class="footer-name">JUAN DAVID MARTINEZ MEDINA</div>
                        </div>
                    </div>
                </StarBorder>
            </div>
        </div>
    </main>
</div>

<script>
    import { initWelcomeInteractive } from "../logic/welcome.js";
    document.addEventListener("astro:page-load", () => {
        initWelcomeInteractive();
    });
</script>
