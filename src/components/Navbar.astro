---
import { Image } from "astro:assets";
import navbarImg from "../assets/photos/portfolio.jpg";
import GooeyNav from "../animations/GooeyNav.jsx";
import NavbarPhone from "../animations/phone/NavbarPhone.jsx";
---

<nav class="navbar" id="main-nav">
    <a href="#home" class="logo" aria-label="Inicio — Juan David Martínez">
        <span class="logo-thumb nav-anim" aria-hidden="true">
            <Image
                src={navbarImg}
                alt=""
                class="logo-mark"
                width={88}
                height={110}
                loading="eager"
            />
        </span>
        <span class="logo-text-wrap nav-anim">
            <span class="logo-text-strong" data-i18n="nav_logo_strong"
                >JUAN DAVID</span
            >
            <span class="logo-text-muted" data-i18n="nav_logo_muted"
                >MARTÍNEZ</span
            >
        </span>
    </a>
    
    <!-- Desktop Navigation -->
    <div class="desktop-only">
        <GooeyNav client:load />
    </div>

    <!-- Mobile Burger Menu -->
    <div class="mobile-only">
        <NavbarPhone client:load />
    </div>

    <!-- Desktop Language Toggle Button -->
    <button
        id="lang-toggle"
        class="lang-btn nav-anim desktop-only"
        aria-label="Toggle Language">EN</button
    >
</nav>

<script>
    import { initNavbarInteractive } from "../logic/navbar.js";

    document.addEventListener("astro:page-load", () => {
        initNavbarInteractive();
    });
</script>

