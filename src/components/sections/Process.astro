---
import { useTranslations, type Lang } from '../../i18n/ui';

type Props = { lang: Lang };
const t = useTranslations(Astro.props.lang);
const total = t.process.stages.length;
---

<!--
  The four stages are planes placed at increasing depth. On desktop the scroll moves a camera
  through them (scripts/scenes.ts); a thread joins the planes so they read as one process.
  Tablets use native horizontal snap scrolling; phones pin the stage to vertical page scroll.
-->
<section class="process" aria-labelledby="process-title" data-process data-process-pin style={`--panes:${total}`}>
  <div class="process__stage" data-process-stage>
    <header class="process__head wrap">
      <h2 class="section-title process__title" id="process-title">{t.process.title}</h2>
      <p class="process__lead">{t.process.lead}</p>
    </header>

    <div class="process__world" data-process-world>
      <ol class="process__list">
        {
          t.process.stages.map((stage, i) => (
            <li class="pane" data-pane style={`--i:${i}`}>
              <div class="pane__card">
                <div class="pane__art" aria-hidden="true">
                  {i === 0 && (
                    <svg viewBox="0 0 240 150">
                      <g class="grid-dots">
                        {Array.from({ length: 6 }).map((_, r) =>
                          Array.from({ length: 10 }).map((_, c) => <circle cx={12 + c * 24} cy={10 + r * 26} r="0.9" />),
                        )}
                      </g>
                      <rect class="draw" pathLength="1" x="18" y="16" width="74" height="40" rx="4" />
                      <rect class="draw" pathLength="1" x="148" y="16" width="74" height="40" rx="4" />
                      <rect class="draw accent" pathLength="1" x="83" y="96" width="74" height="40" rx="4" />
                      <path class="draw" pathLength="1" d="M55 56 V76 H120 V96 M185 56 V76 H120" />
                      <path class="draw thin" pathLength="1" d="M30 30 H70 M30 40 H58 M160 30 H200 M160 40 H188 M95 110 H140 M95 120 H125" />
                    </svg>
                  )}
                  {i === 1 && (
                    <svg viewBox="0 0 240 150">
                      <circle class="draw" pathLength="1" cx="28" cy="75" r="12" />
                      <path class="draw" pathLength="1" d="M40 75 H92" />
                      <path class="draw accent" pathLength="1" d="M120 47 L148 75 L120 103 L92 75 Z" />
                      <path class="draw" pathLength="1" d="M148 75 H168 V36 H184 M148 75 H168 V114 H184" />
                      <rect class="draw" pathLength="1" x="184" y="22" width="44" height="28" rx="4" />
                      <rect class="draw" pathLength="1" x="184" y="100" width="44" height="28" rx="4" />
                      <path class="draw thin" pathLength="1" d="M112 75 H128 M120 67 V83" />
                    </svg>
                  )}
                  {i === 2 && (
                    <svg viewBox="0 0 240 150">
                      <circle class="draw accent" pathLength="1" cx="120" cy="75" r="22" />
                      <path class="draw thin" pathLength="1" d="M106 75 H134 M120 61 V89" />
                      {[
                        [36, 28],
                        [204, 28],
                        [36, 122],
                        [204, 122],
                      ].map(([x, y]) => (
                        <>
                          <rect class="draw" pathLength="1" x={x - 18} y={y - 12} width="36" height="24" rx="5" />
                          <path class="draw dashed" pathLength="1" d={`M${x < 120 ? x + 18 : x - 18} ${y} L${x < 120 ? 101 : 139} ${y < 75 ? 63 : 87}`} />
                        </>
                      ))}
                    </svg>
                  )}
                  {i === 3 && (
                    <svg viewBox="0 0 240 150">
                      <rect class="draw" pathLength="1" x="16" y="12" width="208" height="126" rx="7" />
                      <path class="draw" pathLength="1" d="M16 32 H224" />
                      <circle class="draw" pathLength="1" cx="28" cy="22" r="3" />
                      <circle class="draw" pathLength="1" cx="40" cy="22" r="3" />
                      <circle class="draw" pathLength="1" cx="52" cy="22" r="3" />
                      <rect class="draw" pathLength="1" x="28" y="44" width="46" height="82" rx="4" />
                      <rect class="draw accent" pathLength="1" x="86" y="44" width="126" height="40" rx="4" />
                      <rect class="draw" pathLength="1" x="86" y="94" width="58" height="32" rx="4" />
                      <rect class="draw" pathLength="1" x="154" y="94" width="58" height="32" rx="4" />
                    </svg>
                  )}
                </div>
                <p class="pane__step">
                  <span class="visually-hidden">{t.process.step}</span> {String(i + 1).padStart(2, '0')}
                  <span class="visually-hidden">{t.process.of} {total}</span>
                </p>
                <h3 class="pane__name">{stage}</h3>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

  </div>
</section>

<style>
  .process { position: relative; padding-block: calc(var(--section) * 0.6) var(--section); }

  .process__title::before { content: none; }
  .process__head { display: grid; gap: 0.8rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .process__lead { max-width: 44ch; font-size: var(--step-1); color: var(--muted); }

  .process__list {
    position: relative;
    display: grid;
    gap: 1.5rem;
    width: min(100% - 2 * var(--gutter), 560px);
    margin-inline: auto;
  }

  .pane { position: relative; list-style: none; }
  .pane__card {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: 1.4rem 1.5rem 1.6rem;
    border-radius: 14px;
    border: 1px solid var(--line);
    background:
      linear-gradient(150deg, color-mix(in srgb, var(--surface) 96%, #fff) 0%, color-mix(in srgb, var(--surface) 70%, transparent) 100%);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.25) inset,
      0 40px 70px -40px rgb(10 14 25 / 0.55);
    overflow: hidden;
  }
  /* A sheen that follows the scene's light. */
  .pane__card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, rgb(255 255 255 / 0.12) 50%, transparent 65%);
    transform: translateX(var(--sheen, -60%));
    transition: transform 1.2s var(--ease-out);
    pointer-events: none;
  }
  /* Brass corner ticks, like registration marks on a blueprint. */
  .pane__card::after {
    content: '';
    position: absolute;
    inset: 10px;
    background:
      linear-gradient(var(--brass-light), var(--brass-light)) 0 0 / 14px 1px no-repeat,
      linear-gradient(var(--brass-light), var(--brass-light)) 0 0 / 1px 14px no-repeat,
      linear-gradient(var(--brass-light), var(--brass-light)) 100% 100% / 14px 1px no-repeat,
      linear-gradient(var(--brass-light), var(--brass-light)) 100% 100% / 1px 14px no-repeat;
    opacity: 0.8;
    pointer-events: none;
  }

  .pane__art { color: var(--fg); }
  .pane__art svg { display: block; width: 100%; height: auto; overflow: visible; }
  .pane__art .draw {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.4s var(--ease-out);
  }
  .pane__art .thin { stroke-width: 1; opacity: 0.55; }
  .pane__art .dashed { stroke-dasharray: 0.04 0.03; stroke-dashoffset: 0; opacity: 0; transition: opacity 0.8s 0.6s; }
  .pane__art .accent { stroke: var(--brass-light); stroke-width: 1.8; }
  .pane__art .grid-dots circle { fill: currentColor; opacity: 0.25; }
  .pane.is-lit .draw { stroke-dashoffset: 0; }
  .pane.is-lit .dashed { opacity: 0.7; }
  .pane.is-lit { --sheen: 60%; }
  :global(html:not(.js)) .pane .draw, :global(.reduced) .pane .draw { stroke-dashoffset: 0; }

  .pane__step { font-size: var(--step--1); font-weight: 600; color: var(--brass); font-variant-numeric: tabular-nums; }
  .pane__name { font-size: var(--step-2); font-weight: 650; letter-spacing: -0.03em; line-height: 1.05; }

  /* ---------- Mobile / tablet: native horizontal snap carousel ---------- */
  @media (max-width: 1023px) {
    .process__world {
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: max(var(--gutter), calc((100vw - min(78vw, 360px)) / 2));
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .process__world::-webkit-scrollbar { display: none; }
    .process__list {
      display: flex;
      align-items: stretch;
      gap: 1rem;
      width: max-content;
      margin: 0;
      padding: 0 max(var(--gutter), calc((100vw - min(78vw, 360px)) / 2)) 2rem;
    }
    .pane { flex: 0 0 min(78vw, 360px); scroll-snap-align: center; }
    .pane__card { height: 100%; }
  }

  /* Phones: vertical page scroll pins the cards and glides the track one stage at a time. */
  @media (max-width: 860px) {
    :global(html.process-pinned) .process {
      height: calc(100svh + (var(--panes) - 1) * 55svh);
      padding-block: 0;
    }
    :global(html.process-pinned) .process__stage {
      position: sticky;
      top: var(--nav-h);
      height: calc(100svh - var(--nav-h));
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
    }
    :global(html.process-pinned) .process__head {
      flex: none;
      margin-bottom: clamp(1.5rem, 5vh, 3rem);
    }
    :global(html.process-pinned) .process__world {
      flex: none;
      overflow: visible;
      scroll-snap-type: none;
      touch-action: pan-y;
    }
    :global(html.process-pinned) .process__list {
      width: max-content;
      padding: 0 calc((100vw - min(82vw, 400px)) / 2);
      gap: 1.25rem;
      transform: translate3d(var(--track-x, 0px), 0, 0);
      transition: transform 0.75s var(--ease-door);
      will-change: transform;
    }
    :global(html.process-pinned) .pane { width: min(82vw, 400px); }
    :global(html.process-pinned) .pane__card {
      height: auto;
      opacity: 1;
      transform: translate3d(0, 0, 0);
      box-shadow:
        0 1px 0 rgb(255 255 255 / 0.25) inset,
        0 28px 48px -42px rgb(10 14 25 / 0.28);
    }
  }

  @media (max-width: 768px) {
    .pane,
    .pane__card {
      opacity: 1 !important;
      visibility: visible !important;
      filter: none !important;
    }

    .pane__card {
      background: var(--surface);
      box-shadow: 0 1px 0 rgb(255 255 255 / 0.25) inset, 0 12px 28px -24px rgb(10 14 25 / 0.22);
    }
  }

  /* ---------- Desktop camera flight ---------- */
  @media (min-width: 1024px) {
    :global(html.scenes) .process { height: 360vh; padding-block: 0; }
    :global(html.scenes) .process__stage {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
      perspective: 1100px;
      perspective-origin: var(--px, 50%) var(--py, 45%);
    }
    :global(html.scenes) .process__head {
      position: absolute;
      top: calc(var(--nav-h) + 2rem);
      left: 0;
      right: 0;
      z-index: 2;
      margin: 0 auto;
    }
    :global(html.scenes) .process__world {
      position: absolute;
      inset: 0;
      transform-style: preserve-3d;
      transform: translateZ(var(--cam, 0px));
    }
    :global(html.scenes) .process__list {
      position: absolute;
      inset: 0;
      width: auto;
      margin: 0;
      transform-style: preserve-3d;
    }
    :global(html.scenes) .pane {
      position: absolute;
      left: 50%;
      top: 54%;
      width: 400px;
      margin: -150px 0 0 -200px;
      transform-style: preserve-3d;
      transform: translate3d(var(--x, 0px), var(--y, 0px), var(--z, 0px));
    }
    :global(html.scenes) .pane__card { backface-visibility: hidden; }
  }
</style>
