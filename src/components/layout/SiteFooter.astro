---
import Icon from '../ui/Icon.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { profile } from '../../data/profile';

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <p class="site-footer__farewell" data-reveal>{t.footer.farewell}</p>

    <!-- The name rises into place with perspective as the page ends (scripts/scenes.ts). -->
    <p class="site-footer__band" data-footer-band aria-hidden="true">
      <span>{profile.firstNames}</span> <span>{profile.lastNames}</span>
    </p>

    <div class="site-footer__row">
      <ul class="site-footer__links">
        <li>
          <a href={profile.linkedin.url} target="_blank" rel="noopener noreferrer">
            <Icon name="linkedin" />LinkedIn<span class="visually-hidden"> ({t.a11y.newTab})</span>
          </a>
        </li>
        <li>
          <a href={profile.github.url} target="_blank" rel="noopener noreferrer">
            <Icon name="github" />GitHub<span class="visually-hidden"> ({t.a11y.newTab})</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${profile.email}`}>
            <Icon name="mail" />{profile.email}
          </a>
        </li>
      </ul>

      <div class="site-footer__end">
        <a class="site-footer__top" href="#main">
          {t.footer.top}
          <Icon name="arrowUp" />
        </a>
      </div>
    </div>

    <p class="site-footer__legal">© {year} {profile.name}. {t.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
    border-top: 1px solid var(--line);
    overflow: hidden;
  }
  .site-footer__inner { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); }

  .site-footer__farewell {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.15;
    max-width: 26ch;
  }

  /* The full name as a closing typographic band. */
  .site-footer__band {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.28em;
    font-size: clamp(2.4rem, 6.3vw, 6.9rem);
    font-weight: 780;
    line-height: 0.9;
    letter-spacing: -0.055em;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--fg) 45%, transparent);
    perspective: 900px;
  }
  .site-footer__band span:last-child { color: var(--fg); -webkit-text-stroke: 0; }

  .site-footer__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .site-footer__links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; }
  .site-footer__links a,
  .site-footer__top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    text-decoration: none;
    font-weight: 500;
    color: var(--fg);
  }
  .site-footer__links :global(svg),
  .site-footer__top :global(svg) { width: 1.05rem; height: 1.05rem; fill: currentColor; transition: transform 0.45s var(--ease-out); }
  .site-footer__links a:hover :global(svg) { transform: translateY(-2px) rotate(-6deg); }
  .site-footer__top:hover :global(svg) { transform: translateY(-3px); }

  .site-footer__end { display: flex; align-items: center; }

  .site-footer__legal { font-size: var(--step--1); color: var(--muted); }

  @media (max-width: 640px) {
    .site-footer__band { white-space: normal; font-size: 12.4vw; }
    .site-footer__row { flex-direction: column; align-items: flex-start; }
    .site-footer__links { flex-direction: column; gap: 0.2rem; }
    .site-footer__links a { overflow-wrap: anywhere; }
  }
</style>
